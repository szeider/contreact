{
  "model": {
    "name": "anthropic/claude-sonnet-4.5",
    "temperature": 0.0,
    "streaming": true,
    "max_tokens": 16384,
    "model_kwargs": {
      "stream_options": {"include_usage": true}
    }
  },
  "tools": [
    "think",
    "send_message",
    "stop",
    "memory_list",
    "memory_read",
    "memory_write",
    "memory_search",
    "memory_delete",
    "web_search",
    "extract_content"
  ],
  "execution_mode": "segmented",
  "max_tool_calls": 100,
  "prompts": {
    "react_prompt": "react_prompt.md",
    "instance_prompt": "instance_prompt.md"
  },
  "memory": {
    "similarity": {
      "enabled": true,
      "provider": "local",
      "model": "all-MiniLM-L6-v2"
    }
  },
  "compaction": {
    "enabled": true,
    "trigger_messages": 60,
    "keep_recent": 20
  }
}
